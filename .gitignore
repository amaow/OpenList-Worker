# runtime dir
node_modules
dist
dist-server
public_data

# temp file
*.log
*.tmp
*.temp
*.swp
*.swo
*~

# ide files
.DS_Store
.idea
.test
.codebuddy
.vscode
.env
.env.local
.env.*.local
# real secrets (keep the *.example templates tracked)
.dev.vars
.dev.vars.*
!.dev.vars.example
.wrangler
.reasonix

# build artifacts
*.tsbuildinfo
.rollup.cache

# local-only dev config (may contain real secrets; never commit)
wrangler.d1.toml
wrangler.local.jsonc

# OS files
Thumbs.db
desktop.ini

# test coverage
coverage/
.nyc_output/

# build output (keep in gitignore, should not commit)
pages/dist/
dist-server/
*.tsbuildinfo

# EdgeOne Makers Node 云函数入口 cloud-functions/[[default]].js 必须入库：
# 平台在部署开始时扫描仓库判定项目类型，仓库里没有 cloud-functions/ 会被识别为
# 纯静态站（构建日志："未检测到 server-handler"），导致 /api/* 永远到不了云函数。
# 每次部署 pnpm run build 都会重新生成覆盖它，入库的只是占位/触发器。
# 注意：构建校验见 .github/workflows/build-verify.yml

# source maps (optional, can be removed)
*.map
*.js.map
*.css.map

# lock files (keep pnpm-lock.yaml only)
package-lock.json
yarn.lock

# misc
.cache/
.parcel-cache/
.turbo/

# cleanup scripts are tracked
!cleanup.bat
!cleanup.sh

# Security: Prevent sensitive files from being committed (Added: 2026-09-05)
*.key
*.pem
*.p12
*.pfx
*.cer
*.crt
**/.env
pages/.env
.env.production
.env.development
*.secret

# Security audit reports (contain sensitive information)
docs/3-Audit-Reports/
docs/*AUDIT*.md
docs/*SECURITY*.md
docs/TASK-COMPLETION-REPORT.md
# Local design/PR/review notes (kept on disk, not tracked)
docs/storage-architecture.md
docs/PR-config-unification.md
docs/code-review-*.md
wrangler.d1.jsonc
.wrangler-dryrun/
.tmp-dryrun/

